# Copy to `.env.production` for local `npm run mobile:sync` / `npm run mobile:release`.
# Never commit `.env.production` — it contains public SDK keys (safe in apps, but repo hygiene).

# Kitchen API (baked into native builds; web on Railway uses same-origin empty base)
VITE_API_BASE=https://YOUR-RAILWAY-DOMAIN.up.railway.app

# RevenueCat public SDK keys — Project → Apps → API keys (NOT secret sk_ keys)
VITE_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firebase web config (optional — firebase.ts has cookwithgio defaults)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=cookwithgio.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=cookwithgio
# VITE_FIREBASE_STORAGE_BUCKET=cookwithgio.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=600120662842
# VITE_FIREBASE_APP_ID=1:600120662842:web:e0bcfaaf3ee4875bac8e03
# VITE_FIREBASE_API_KEY=AIzaSyByrDCBQGbJLiysAR3ckHva6Wrtj3K9U_c

# --- Railway service variables (set via `railway variable set`, not in client .env) ---
# ANTHROPIC_API_KEY=sk-ant-...
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}  # single line from Firebase Console
# REVENUECAT_WEBHOOK_SECRET=   # openssl rand -hex 32 — must match RevenueCat webhook Authorization header